    create  table
      "snap_deals_stage__dbt_tmp20260804084727128513"
  
    as (
      
    
    with snapshot_query as (

        



-- SCD2 do estágio do deal: cada mudança de dealstage gera uma nova
-- versão com dbt_valid_from/dbt_valid_to. Base do analytics_deal_stage_hist.
select
    deal_id,
    pipeline_id,
    stage_id
from "lake_catalog"."main_staging"."stg_hubspot__deals"


    ),

    snapshotted_data as (

        select *, 
    
        deal_id as dbt_unique_key
    

        from "lake_catalog"."snapshots"."snap_deals_stage"
        where
            
                dbt_valid_to is null
            

    ),

    insertions_source_data as (

        select *, 
    
        deal_id as dbt_unique_key
    
,
            now()::timestamp as dbt_updated_at,
            now()::timestamp as dbt_valid_from,
            
  
  coalesce(nullif(now()::timestamp, now()::timestamp), null)
  as dbt_valid_to
,
            md5(coalesce(cast(deal_id as varchar ), '')
         || '|' || coalesce(cast(now()::timestamp as varchar ), '')
        ) as dbt_scd_id

        from snapshot_query
    ),

    updates_source_data as (

        select *, 
    
