[0m08:29:10.955330 [debug] [Thread-4 (]: On model.hubspot_analytics.analytics_deals: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "hubspot_analytics", "target_name": "lake", "node_id": "model.hubspot_analytics.analytics_deals"} */

  
    
    

    create  table
      "lake"."main_gold"."analytics_deals"
  
    as (
      

with principal as (
    select deal_id, min(contact_id) as primary_contact_id
    from "lake"."main_gold"."assoc_deal_contact"
    where is_primary
    group by 1
),

qualquer_contato as (
    select deal_id, min(contact_id) as contact_id
    from "lake"."main_gold"."assoc_deal_contact"
    group by 1
),

empresa as (
    select deal_id, min(company_id) as company_id
    from "lake"."main_gold"."assoc_deal_company"
    group by 1
)

select
    d.deal_id,
    deal_name,
    pipeline_id,
    stage_id,
    amount,
    owner_id,
    deal_type,
    created_at,
    updated_at,
    close_date,
    coalesce(p.primary_contact_id, q.contact_id) as primary_contact_id,
    e.company_id,
    -- deriváveis do estágio; ajustar aos ids reais dos estágios de
    -- fechamento do pipeline de vocês (API de pipelines resolve labels)
    coalesce(stage_id ilike '%closedwon%', false)   as is_won,
    coalesce(stage_id ilike '%closed%', false)      as is_closed,
    _loaded_at
from "lake"."main_staging"."stg_hubspot__deals" d
left join principal p on d.deal_id = p.deal_id
left join qualquer_contato q on d.deal_id = q.deal_id
left join empresa e on d.deal_id = e.deal_id


    );
  
  
  
