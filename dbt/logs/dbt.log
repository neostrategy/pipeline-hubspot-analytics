with raw as (

    select *
    from "awsdatacatalog"."samsung_hubspot_raw"."deals"

    
    where dt >= (
        select coalesce(max(date_format(_loaded_at, '%Y-%m-%d')), '1900-01-01')
        from "awsdatacatalog"."samsung_hubspot_stg"."stg_hubspot__deals"
    )
    

),

